 *
 * tsconfig.json: The project IDEs and typescript-eslint's project service discover, and the pass `npm run typecheck` runs. It type-checks everything under src, the
 * test and helper files tsconfig.build.json leaves out of the published output included, while `noEmit` keeps `tsc -p tsconfig.json` from producing build output -
 * emitting the published `dist/` is tsconfig.build.json's job. The web UI's JavaScript and eslint.config.mjs are not inputs here: typescript-eslint lints them through
 * the default project that eslint.config.mjs's allowDefaultProject list names.
 */
{
  "compilerOptions": {

    "noEmit": true
  },

  "exclude": [ "dist", "node_modules" ],
  "extends": "./node_modules/homebridge-plugin-utils/build/tsconfig.plugin.json",
  "include": [ "src" ]
}
