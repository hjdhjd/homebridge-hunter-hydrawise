{
  "name": "homebridge-hunter-hydrawise",
  "displayName": "Hunter Hydrawise",
  "version": "2.0.0",
  "description": "HomeKit integration for Hunter Hydrawise Irrigation Controllers.",
  "license": "ISC",
  "author": {
    "name": "HJD",
    "url": "https://github.com/hjdhjd"
  },
  "homepage": "https://github.com/hjdhjd/homebridge-hunter-hydrawise#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/hjdhjd/homebridge-hunter-hydrawise.git"
  },
  "bugs": {
    "url": "https://github.com/hjdhjd/homebridge-hunter-hydrawise/issues"
  },
  "type": "module",
  "engines": {
    "homebridge": ">=2.0.0",
    "node": ">=22.20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-docs": "npm run build && homebridge-plugin-utils prepare-docs dist/options.js && homebridge-plugin-utils prepare-chrome docChrome.json",
    "build-ui": "homebridge-plugin-utils prepare-ui homebridge-ui/public/lib",
    "clean": "node -e \"for(const p of ['dist','homebridge-ui/public/lib'])require('node:fs').rmSync(p,{force:true,recursive:true})\"",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"0\"} eslint.config.mjs src homebridge-ui/*.js homebridge-ui/public/**.mjs",
    "postpublish": "npm run clean",
    "prebuild": "npm run clean && npm run build-ui",
    "prelint": "npm run build-ui",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build",
    "test": "node --strip-types --experimental-test-module-mocks --test --test-force-exit --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/**/*.helpers.ts\" --test-coverage-exclude=\"src/**/*.fixtures.ts\" --test-coverage-exclude=\"src/index.ts\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 --test-timeout=15000 \"src/**/*.test.ts\"",
    "test:watch": "node --strip-types --experimental-test-module-mocks --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "garden",
    "homebridge",
    "homebridge-plugin",
    "hunter",
    "hydrawise",
    "irrigation",
    "irrigation controller",
    "irrigation system",
    "lawn",
    "sprinkler",
    "water"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.2.0",
    "eslint": "9.39.2",
    "homebridge": "2.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.5",
    "homebridge-plugin-utils": "2.3.1",
    "undici": "8.10.0"
  }
}
